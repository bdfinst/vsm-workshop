{
  "extraKnownMarketplaces": {
    "bfinster": {
      "source": {
        "source": "git",
        "url": "https://github.com/bdfinst/agentic-dev-team.git"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "dev-team@bfinster": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/install-dev-team.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/install-playwright.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.js|*.svelte|*.json|*.css|*.md) npx --no-install prettier --write \"$f\" >/dev/null 2>&1; case \"$f\" in *.js|*.svelte) npx --no-install eslint --fix \"$f\" >/dev/null 2>&1;; esac;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
