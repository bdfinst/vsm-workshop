{
  "name": "vsm-workshop",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:standalone": "vite build --config vite.standalone.config.js",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "vitest run",
    "pretest:acceptance": "npm run build && npm run build:standalone",
    "test:acceptance": "playwright test",
    "test:all": "npm test && npm run test:acceptance",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test visual.spec.js",
    "test:e2e:visual:update": "playwright test visual.spec.js --update-snapshots",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.5.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.0.0",
    "layerchart": "^1.0.13",
    "lucide-svelte": "^0.469.0",
    "svelte": "^5.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.58.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.23",
    "d3-scale": "^4.0.2",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.3.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.18"
  }
}
